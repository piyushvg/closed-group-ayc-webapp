# Copy to .env.local (dev) or .env.production.local (prod server) and fill in.
# Never commit real values.

# Firebase web app — Firebase console → Project settings → Your apps → Web app.
# NEXT_PUBLIC_* are baked into client JS at build time: rebuild after changing.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Sub-path the site is served under: "/aycapp" in prod, leave empty locally.
# Baked in at build time — rebuild after changing.
NEXT_PUBLIC_BASE_PATH=

# Frappe backend (server-only). Base URL without trailing slash.
FRAPPE_BASE_URL=
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# Signs the session cookie. Generate: openssl rand -base64 48
# Use a different value per environment; changing it logs everyone out.
SESSION_SECRET=
